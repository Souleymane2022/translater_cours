{
  "name": "Traducteur de Cours en direct",
  "short_name": "Traducteur",
  "description": "Traduction en temps réel des cours, conférences et réunions, dans votre langue.",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b1020",
  "theme_color": "#1d4ed8",
  "share_target": {
    "action": "./?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "media", "accept": ["audio/*", "video/*"] }] }
  },
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }
  ]
}
